# Bundler config
/dullscythe/.bundle

# Environment files
/dullscythe/.env*

# Logs and tempfiles
/dullscythe/log/*
/dullscythe/tmp/*
!/dullscythe/log/.keep
!/dullscythe/tmp/.keep

# Pidfiles, but keep the directory
/dullscythe/tmp/pids/*
!/dullscythe/tmp/pids/
!/dullscythe/tmp/pids/.keep

# Storage (dev uploads and SQLite databases)
/dullscythe/storage/*
!/dullscythe/storage/.keep
/dullscythe/tmp/storage/*
!/dullscythe/tmp/storage/
!/dullscythe/tmp/storage/.keep

/dullscythe/public/assets

# Credential key files
/dullscythe/config/*.key

# Node, if you use it
/dullscythe/node_modules

# OS junk
.DS_Store

**/docs/inspiration/
**/docs/references.txt